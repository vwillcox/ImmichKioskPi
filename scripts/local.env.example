# Copy this to scripts/local.env and edit for your own Pi.
# scripts/local.env is git-ignored, so your username/host stay out of the repo.
#
#   cp scripts/local.env.example scripts/local.env

# SSH target for the Pi (user@host).
PI_HOST=pi@raspberrypi.local

# Where the source is synced to on the Pi.
PI_DIR=/home/pi/immich_kiosk_pi
