# Copy to .env and adjust. Values here match the ImmichKioskPi Pi as set up;
# on a different machine, re-check the UID and the exact PipeWire device names
# with `wpctl status` / `pw-dump` — autodetect can pick the wrong microphone
# when more than one is attached, which is exactly the situation here (the
# kiosk also has a USB speaker with its own built-in mic).
LVA_USER_ID="1000"
LVA_USER_GROUP="1000"
LVA_PULSE_SERVER="/run/user/${LVA_USER_ID}/pulse/native"
LVA_XDG_RUNTIME_DIR="/run/user/${LVA_USER_ID}"

CLIENT_NAME="kiosk"

# Webcam mic, not the USB speaker's own mic — the latter shares an enclosure
# with the speaker and hears everything the kiosk plays, wake word included.
AUDIO_INPUT_DEVICE="alsa_input.usb-HD_Webcam_C270_HD_Webcam_C270-02.analog-stereo"
AUDIO_OUTPUT_DEVICE="alsa_output.usb-Generic_USB2.0_Device_20121120222017-01.analog-stereo"

WAKE_MODEL="hey_jarvis"

# Left at the project default (0): our own satellite unit's auto-gain and
# noise suppression made things worse, not better - raw capture from this
# webcam already transcribes correctly. Measure before turning these up.
# MIC_AUTO_GAIN="0"
# MIC_NOISE_SUPPRESSION="0"
