[Unit]
Description=Wyoming satellite — makes the kiosk listen for Home Assistant Assist
After=network-online.target sound.target

[Service]
Type=simple
# Capture from the webcam and play through the USB speaker — two separate
# devices, so the microphone isn't sitting inside the enclosure that's playing
# the music. The card is addressed by name rather than index, because index
# ordering changes when USB devices are re-enumerated.
#
# Playback goes through PipeWire (pw-cat) rather than ALSA directly: PipeWire
# already holds the speaker for the phone's Bluetooth audio, so anything asking
# ALSA for the hardware gets "Device or resource busy" and the satellite loses
# its voice — no listening tone, no spoken reply. pw-cat mixes instead of
# demanding the card.
#
# The satellite plays no sounds at all unless it is given WAV files, so without
# --awake-wav there is no cue that it has started listening — you end up talking
# into silence with no idea whether it heard the wake word. The tones are
# generated by deploy/make_satellite_sounds.py.
ExecStart=%h/wyoming-satellite/.venv/bin/python -m wyoming_satellite \
  --name "Kiosk" \
  --uri tcp://0.0.0.0:10700 \
  --mic-command "arecord -D plughw:CARD=C270,DEV=0 -r 16000 -c 1 -f S16_LE -t raw -q" \
  --snd-command "pw-cat --playback --raw --format=s16 --rate=22050 --channels=1 -" \
  --awake-wav %h/wyoming-satellite/sounds/awake.wav \
  --done-wav %h/wyoming-satellite/sounds/done.wav \
  --wake-uri tcp://127.0.0.1:10400 \
  # Must match the name the wake service advertises exactly: openWakeWord
  # calls this "okay_nabu", and a near-miss like "ok_nabu" matches nothing,
  # so detections are silently discarded and it simply never triggers.
  --wake-word-name "okay_nabu"
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/.cache/immich_kiosk_pi/satellite.log
StandardError=append:%h/.cache/immich_kiosk_pi/satellite.log

[Install]
WantedBy=default.target
